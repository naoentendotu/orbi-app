<Window x:Class="Orbi.Shell.RadialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbi" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="676" Height="460" FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="Pop" ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColA" Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition x:Name="ColB" Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Ring: soft diffuse shadow under the whole pie -->
        <Canvas x:Name="Ring" Grid.Column="0" Width="300" Height="300" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="Spin"/>
            </Canvas.RenderTransform>
            <Canvas.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.28"/>
            </Canvas.Effect>
        </Canvas>

        <Border x:Name="Panel" Grid.Column="2" Style="{StaticResource Panel}" Visibility="Collapsed"
                VerticalAlignment="Center" MaxHeight="440" Margin="0,10" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelPop"/>
            </Border.RenderTransform>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button x:Name="BackBtn" Style="{StaticResource IconBtn}" Content="&#xE72B;" ToolTip="Voltar"
                            Visibility="Collapsed" Click="Back_Click" Margin="-4,0,6,0"/>
                    <Button x:Name="PinBtn" DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE718;"
                            ToolTip="Fixar aberto" Click="Pin_Click" Margin="0,0,-4,0"/>
                    <TextBlock x:Name="PanelTitle" Style="{StaticResource Title}" FontSize="16"/>
                </DockPanel>
                <!-- Feedback pill: slides up and fades -->
                <Border x:Name="Toast" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,5"
                        CornerRadius="12" Background="{DynamicResource ControlBrush}" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastShift"/>
                    </Border.RenderTransform>
                    <TextBlock x:Name="ToastText" Style="{StaticResource Sub}" Foreground="{DynamicResource TextBrush}"/>
                </Border>
                <ContentControl x:Name="PanelContent" Focusable="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform x:Name="ContentShift"/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </DockPanel>
        </Border>
    </Grid>
</Window>
